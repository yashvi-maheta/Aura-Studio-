# Copy this file to .env and fill in values before starting the server.

# Port the server listens on
PORT=4000

# Secret used to sign session cookies – change to a long random string in production
SESSION_SECRET=change_me_to_a_long_random_string

# Admin credentials seeded on first start (plain text here; stored hashed in DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# CORS origin – set to the client's dev URL
CLIENT_ORIGIN=http://localhost:5173
